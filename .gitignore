# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# personal documents (resume source + extracted text). Never committed: real name,
# address, phone and email. The DB copy is what the app reads at runtime.
/private/

# browser-automation output from local verification runs
.playwright-mcp/
/*.png

# lavish review artifacts (HTML review surfaces, not source)
/.lavish/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
