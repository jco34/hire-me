# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored. Never commit real credentials.

# Local Postgres 18. Replace YOUR_PASSWORD with your postgres user's password.
# Create the database first:  createdb -U postgres hire_me
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hire_me

